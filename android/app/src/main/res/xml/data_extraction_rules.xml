<?xml version="1.0" encoding="utf-8"?>
<!--
  Exclude all app data from cloud backup and device-to-device transfer.
  CV drafts live in WebView localStorage (app_webview) and must not be restored
  after clear storage, uninstall, or reinstall.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
