# ─────────────────────────────────────────────────────────────────
# ENVIRONMENT VARIABLES — copy to .env.local for local dev,
# or set in Vercel Dashboard → Project → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────────

# ── AI Provider (SERVER-SIDE ONLY) ────────────────────────────
# Used exclusively in /src/app/api/generate/route.ts (Next.js API route).
# NEVER prefix with NEXT_PUBLIC_ — doing so would expose the key to the browser.
ANTHROPIC_API_KEY=

# ── CV Simple V1 (client-side feature flag; disabled by default) ───────────
# Introduces independent persisted CV contentLocale and cv.summary authority.
NEXT_PUBLIC_CV_SIMPLE_V1=false

# ── Pro Token Signing Key (SERVER-SIDE ONLY) ──────────────────
# Used by /src/app/api/verify-pro/ and /src/app/api/generate/route.ts
# to sign and verify Pro status tokens. Prevents client-side
# localStorage tampering from unlocking Pro AI features.
# Generate a random 32+ character string:
#   node -e "console.log(crypto.randomBytes(32).toString('hex'))"
PRO_SIGNING_KEY=

# ── RevenueCat Android Public API Key (CLIENT-SIDE, Capacitor only) ────
# Used by /src/lib/iap.ts to initialise the RevenueCat SDK on Android.
# This is the PUBLIC key from RevenueCat dashboard → Settings → API Keys.
# Safe to expose in the native app bundle — it is NOT a secret.
# Prefix MUST be NEXT_PUBLIC_ for Next.js client-side access.
NEXT_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# ── RevenueCat Secret API Key (SERVER-SIDE ONLY) ──────────────────────
# Used by /src/app/api/verify-pro/route.ts to validate customer entitlements
# server-side via the RevenueCat V2 REST API.
# This is the V2 SECRET key from RevenueCat dashboard → Settings → API Keys.
# Parties with "sk_v2_..."
# NEVER prefix with NEXT_PUBLIC_ — doing so would expose billing data.
REVENUECAT_SECRET_API_KEY=

# ── RevenueCat Project ID (SERVER-SIDE ONLY) ─────────────────────────
# Found in RevenueCat Dashboard → Project Settings → General → Project ID.
# Required by the V2 active_entitlements endpoint:
#   /v2/projects/{project_id}/customers/{customer_id}/active_entitlements
REVENUECAT_PROJECT_ID=

# ── RevenueCat Internal Entitlement ID (SERVER-SIDE ONLY) ────────────
# The internal RevenueCat entitlement ID (typically begins with "entl_").
# This is NOT the display name or lookup key ("CV Pro AI Pro").
# To discover: after setting REVENUECAT_SECRET_API_KEY and
# REVENUECAT_PROJECT_ID, run:
#   curl -H "Authorization: Bearer $REVENUECAT_SECRET_API_KEY" \
#     "https://api.revenuecat.com/v2/projects/$REVENUECAT_PROJECT_ID/entitlements"
# Then find the entry whose "lookup_key" is "CV Pro AI Pro" and use its "id".
REVENUECAT_ENTITLEMENT_ID=

# ── API Base URL for native builds (Capacitor only) ──────────────────────
# Required for Capacitor static export (Android APK / iOS IPA).
# Native Android must NOT call a relative /api path. Set this to your
# deployed Vercel production URL (e.g. https://cvproai.vercel.app).
# Prefix MUST be NEXT_PUBLIC_ for Next.js client-side access at build time.
NEXT_PUBLIC_API_BASE_URL=

